# Copy to `.dev.vars` (git-ignored) for local testing of the Pages Function with `wrangler pages dev`.
# In production, set these in Cloudflare Pages -> Settings -> Variables and Secrets.

# Required for enquiry emails
RESEND_API_KEY=
# Sender of the internal enquiry email. Must be on a domain verified in Resend, e.g. "ROSS 360 <enquiries@ross360.co.uk>"
QUOTE_FROM_EMAIL=

# Optional. Leave unset: enquiries go to newquote@ross360.co.uk. Setting it overrides that address.
QUOTE_TO_EMAIL=
# Optional: set to "true" to also send the customer an acknowledgement email (sent from contact@ross360.co.uk)
SEND_ACKNOWLEDGEMENT=false
# Optional: Cloudflare Turnstile *secret key* (pair with VITE_TURNSTILE_SITE_KEY)
TURNSTILE_SECRET_KEY=

# Reserved for later. Not used by any code yet (see README: Stripe).
# STRIPE_SECRET_KEY=

# Admin (see README: Admin). Generate the hash with `npm run admin:hash` — never commit a real one.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
